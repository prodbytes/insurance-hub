  <decision name="AuditResult" id="_VAD00001-0000-0000-0000-000000000001">
    <variable name="AuditResult" id="_VAD00001-0000-0000-0000-000000000002" typeRef="string" />
    <informationRequirement id="_VAD00001-0000-0000-0000-0000000000A1">
      <requiredInput href="#_VAI00001-0000-0000-0000-000000000001" />
    </informationRequirement>
    <decisionTable id="_VAD00001-0000-0000-0000-000000000010" typeRef="string" hitPolicy="UNIQUE" label="AuditResult">
