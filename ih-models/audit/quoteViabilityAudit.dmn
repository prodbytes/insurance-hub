        <inputExpression id="_VAD00001-0000-0000-0000-000000000012" typeRef="number">
          <text>risk_rate</text>
        </inputExpression>
      </input>
      <output id="_VAD00001-0000-0000-0000-000000000013" />
      <annotation name="Annotations" />
      <rule id="_VAR00001-0000-0000-0000-000000000001">
        <inputEntry id="_VAR00001-0000-0000-0000-000000000002">
          <text>&lt; 0.05</text>
        </inputEntry>
        <outputEntry id="_VAR00001-0000-0000-0000-000000000003">
          <text>&quot;ERROR&quot;</text>
        </outputEntry>
        <annotationEntry>
          <text>Rate too low to be viable</text>
        </annotationEntry>
      </rule>
      <rule id="_VAR00002-0000-0000-0000-000000000001">
        <inputEntry id="_VAR00002-0000-0000-0000-000000000002">
          <text>[0.05..0.10]</text>
        </inputEntry>
        <outputEntry id="_VAR00002-0000-0000-0000-000000000003">
          <text>&quot;OK&quot;</text>
        </outputEntry>
        <annotationEntry>
          <text>Healthy rate range</text>
        </annotationEntry>
      </rule>
      <rule id="_VAR00003-0000-0000-0000-000000000001">
        <inputEntry id="_VAR00003-0000-0000-0000-000000000002">
          <text>(0.10..0.12]</text>
        </inputEntry>
        <outputEntry id="_VAR00003-0000-0000-0000-000000000003">
          <text>&quot;WARNING&quot;</text>
        </outputEntry>
        <annotationEntry>
          <text>Elevated rate, review recommended</text>
        </annotationEntry>
      </rule>
      <rule id="_VAR00004-0000-0000-0000-000000000001">
        <inputEntry id="_VAR00004-0000-0000-0000-000000000002">
          <text>&gt; 0.12</text>
        </inputEntry>
        <outputEntry id="_VAR00004-0000-0000-0000-000000000003">
          <text>&quot;ERROR&quot;</text>
        </outputEntry>
        <annotationEntry>
          <text>Rate too high to be viable</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
